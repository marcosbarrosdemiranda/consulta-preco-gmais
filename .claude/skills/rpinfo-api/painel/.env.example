# Copie este arquivo pra ".env" (no mesmo diretório) e preencha com os dados DA SUA instalação
# RP Info. Nunca commitar o ".env" de verdade — ele já fica fora do git (ver .gitignore).

# --- API REST (obrigatório pra abas "Conexão API-Banco", "Endpoint de Negócio" e "Ofertas por Loja") ---
RPINFO_API_BASE_URL=http://192.168.1.4:9000
RPINFO_API_USUARIO=000000
RPINFO_API_SENHA=troque-por-sua-senha

# --- Postgres direto (OPCIONAL — só preencher se for mesmo usar a aba de banco; ver
# CLAUDE.md/SKILL.md sobre a API ser sempre a via preferida, banco direto é última instância) ---
RPINFO_DB_HOST=192.168.1.10
RPINFO_DB_PORT=5432
RPINFO_DB_USER=
RPINFO_DB_PASSWORD=

# Lista de bancos permitidos nesta instalação, separados por vírgula (sem espaço antes/depois
# do nome). Vazio = aba de banco direto fica desabilitada. Os 3 bancos do cliente de origem
# desta skill eram "erp,vdadet,wrpdv" — troque pelos nomes reais do SEU ambiente.
RPINFO_DB_BANCOS=
